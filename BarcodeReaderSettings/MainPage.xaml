<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:dynamsoft="clr-namespace:Dynamsoft.CameraEnhancer.Maui;assembly=Dynamsoft.CaptureVisionBundle.Maui"
             Shell.NavBarIsVisible="False"
             x:Class="BarcodeReaderSettings.MainPage">

    <Grid>
        <dynamsoft:CameraView
            x:Name="camera"
            HorizontalOptions="Fill"
            VerticalOptions="Fill" />

        <Border
            VerticalOptions="End"
            BackgroundColor="#B3000000"
            Padding="16,16,16,40"
            MinimumHeightRequest="120">
            <VerticalStackLayout Spacing="8">
                <Label
                    x:Name="ResultCountLabel"
                    Text="Total Results: 0"
                    TextColor="White"
                    FontSize="14"
                    FontAttributes="Bold" />

                <ScrollView MaximumHeightRequest="180">
                    <Label
                        x:Name="ResultTextLabel"
                        Text="Waiting for barcode..."
                        TextColor="#69F0AE"
                        FontSize="14"
                        LineBreakMode="WordWrap" />
                </ScrollView>
            </VerticalStackLayout>
        </Border>
    </Grid>

</ContentPage>
