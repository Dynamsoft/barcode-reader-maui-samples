<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:dynamsoft="clr-namespace:Dynamsoft.CameraEnhancer.Maui;assembly=Dynamsoft.CaptureVisionBundle.Maui"
             x:Class="LocateAnItemWithBarcode.CameraPage"
             BackgroundColor="Black"
             Title="Locate Item">
    <Grid>
        <dynamsoft:CameraView x:Name="CameraView"
                              HorizontalOptions="Fill"
                              VerticalOptions="Fill" />

        <GraphicsView x:Name="OverlayCanvas"
                      InputTransparent="True"
                      HorizontalOptions="Fill"
                      VerticalOptions="Fill" />

        <Button x:Name="LocateAnotherButton"
                Text="Locate another item"
                IsVisible="False"
                BackgroundColor="#F5A623"
                TextColor="White"
                FontSize="14"
                FontAttributes="Bold"
                CornerRadius="6"
                Padding="12,8"
                HorizontalOptions="End"
                VerticalOptions="Start"
                Margin="16"
                Clicked="OnLocateAnotherClicked" />

        <Border x:Name="StatusContainer"
                IsVisible="False"
                HorizontalOptions="Fill"
                VerticalOptions="End"
                Margin="16,0,16,8"
                Padding="16,12"
                StrokeThickness="0"
                BackgroundColor="#B3000000"
                StrokeShape="RoundRectangle 8">
            <Label x:Name="StatusLabel"
                   HorizontalTextAlignment="Center"
                   TextColor="White"
                   FontSize="16"
                   FontAttributes="Bold" />
        </Border>
    </Grid>
</ContentPage>
