<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ScanBarcodes_ReadyToUseComponent.MainPage">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollView Grid.Row="0" 
                    HorizontalOptions="Center"
                    VerticalOptions="Center">
            <Label
                x:Name="label"
                Text="Click button to Scan Barcodes"      
                FontSize="16"
                SemanticProperties.Description="Click button to Scan a Barcode"
                HorizontalOptions="Center"
                VerticalOptions="Center" />
        </ScrollView>

        <Button
            Grid.Row="1"
            x:Name="BtnScanSingle"
            Text="Scan single Barcode"
            SemanticProperties.Hint="Click button to Scan single Barcode"
            Clicked="OnScanSingleBarcode"
            HorizontalOptions="Center"
            VerticalOptions="End"
            Margin="0,20" />
        
        <Button
            Grid.Row="2"
            x:Name="BtnScanMultiple"
            Text="Scan Multiple Barcodes"
            SemanticProperties.Hint="Click button to Scan Multiple Barcodes"
            Clicked="OnScanMultipleBarcode"
            HorizontalOptions="Center"
            VerticalOptions="End"
            Margin="0,20" />
    </Grid>
</ContentPage>

